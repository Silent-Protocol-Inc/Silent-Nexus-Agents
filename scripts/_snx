(( $+functions[_snx_commands] )) ||
_snx_commands() {
    local commands; commands=(
'chat:Launch the interactive TUI (default when no command is given)' \
'run:Run one objective to completion, non-interactively' \
'goal:Persistent, verifiable goals' \
'session:Conversation sessions' \
'memory:Long-term memory (approval-gated, secret-refusing)' \
'skill:Versioned, inspectable skills' \
'mcp:Model Context Protocol servers (client + server)' \
'sandbox:Execution sandbox inspection and self-test' \
'index:Code intelligence index' \
'tools:Available tools and their risk levels' \
'models:Configured models and their health' \
'config:Configuration inspection' \
'audit:Show recent audit events' \
'logs:Show where structured logs are written' \
'doctor:Environment and readiness diagnostics' \
'completion:Generate a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'snx commands' commands "$@"
}
(( $+functions[_snx__subcmd__audit_commands] )) ||
_snx__subcmd__audit_commands() {
    local commands; commands=()
    _describe -t commands 'snx audit commands' commands "$@"
}
(( $+functions[_snx__subcmd__chat_commands] )) ||
_snx__subcmd__chat_commands() {
    local commands; commands=()
    _describe -t commands 'snx chat commands' commands "$@"
}
(( $+functions[_snx__subcmd__completion_commands] )) ||
_snx__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'snx completion commands' commands "$@"
}
(( $+functions[_snx__subcmd__config_commands] )) ||
_snx__subcmd__config_commands() {
    local commands; commands=(
'show:Print the effective configuration' \
'path:Print the config file locations' \
'schema:Print the configuration JSON schema' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'snx config commands' commands "$@"
}
(( $+functions[_snx__subcmd__config__subcmd__help_commands] )) ||
_snx__subcmd__config__subcmd__help_commands() {
    local commands; commands=(
'show:Print the effective configuration' \
'path:Print the config file locations' \
'schema:Print the configuration JSON schema' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'snx config help commands' commands "$@"
}
(( $+functions[_snx__subcmd__config__subcmd__help__subcmd__help_commands] )) ||
_snx__subcmd__config__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
