#compdef snx

autoload -U is-at-least

_snx() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_snx_commands" \
"*::: :->snx" \
&& ret=0
    case $state in
    (snx)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-command-$line[1]:"
        case $line[1] in
            (chat)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
'--agent=[Agent role\: orchestrator, planner, implementer, researcher, debugger, reviewer, verifier, security, documentation]:AGENT:_default' \
'--session=[Continue an existing session by id]:SESSION:_default' \
'--yes[Auto-approve escalated actions (explicit, audited authorization)]' \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::objective -- The objective for the agent to accomplish:_default' \
&& ret=0
;;
(goal)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_snx__subcmd__goal_commands" \
"*::: :->goal" \
&& ret=0

    case $state in
    (goal)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-goal-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(new)
_arguments "${_arguments_options[@]}" : \
'*-c+[Acceptance criterion (repeatable). A goal only completes when each has evidence]:CRITERIA:_default' \
'*--criterion=[Acceptance criterion (repeatable). A goal only completes when each has evidence]:CRITERIA:_default' \
'--objective=[]:OBJECTIVE:_default' \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::title:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':id:_default' \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':id:_default' \
&& ret=0
;;
(recover)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':id:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_snx__subcmd__goal__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-goal-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(new)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(verify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(recover)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(session)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_snx__subcmd__session_commands" \
"*::: :->session" \
&& ret=0

    case $state in
    (session)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-session-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
