'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':id:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_snx__subcmd__session__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-session-help-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(memory)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_snx__subcmd__memory_commands" \
"*::: :->memory" \
&& ret=0

    case $state in
    (memory)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:snx-memory-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--all[]' \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'--kind=[]:KIND:_default' \
'--scope=[]:SCOPE:_default' \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
'--json[Emit machine-readable JSON where supported]' \
'-v[Increase log verbosity]' \
'--verbose[Increase log verbosity]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::content:_default' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'--no-color[Disable colored output (also honors NO_COLOR and config)]' \
