'untrust:Mark a server untrusted (its tools require per-call approval)' \
'tools:Connect to a registered server and list its tools' \
'serve:Run Silent Nexus as an MCP server over stdio (curated read-only tools)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'snx mcp commands' commands "$@"
